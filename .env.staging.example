# Staging Environment Configuration Template
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# Copy this file to .env.staging on the staging host and populate with secure values.

APP_ENV=staging
DEBUG=false

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=staging_app
POSTGRES_PASSWORD=generate_a_secure_database_password_here
POSTGRES_DB=consciousai_staging
DATABASE_URL=postgresql://staging_app:generate_a_secure_database_password_here@db:5432/consciousai_staging

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis Cache & Rate Limiting (Redis 7)
REDIS_URL=redis://redis:6379/0

# Authentication & Security
# MUST be a randomly generated cryptographically secure string of at least 32 characters
# Example generator: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_random_32_plus_char_secret_key_for_staging
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting & Access
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_JOURNAL_PER_MINUTE=30

# CORS Allowed Origins (Comma-separated, no wildcards in staging/prod)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Server Performance & Operational Settings
WORKERS=2
GRACEFUL_TIMEOUT=30
LOG_LEVEL=INFO
ENABLE_API_DOCS=true
