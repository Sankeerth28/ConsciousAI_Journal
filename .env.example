# ===========================================================
# ConsciousAI Journal V2 — Environment Configuration
# ===========================================================
# Copy this file to .env and edit the values.
# Do NOT commit your .env file — it is gitignored.
# ===========================================================

# --- Application ---
APP_NAME=ConsciousAI Journal
APP_ENV=development
APP_VERSION=2.0.0a1
DEBUG=true

# --- Database ---
# PostgreSQL (Staging / Docker Compose)
POSTGRES_USER=consciousai
POSTGRES_PASSWORD=consciousai_dev_password
POSTGRES_DB=consciousai_staging

# SQLite (local development):
DATABASE_URL=sqlite:///./data/consciousai.db
# PostgreSQL (Docker Compose staging exposed host port 5433):
# DATABASE_URL=postgresql://consciousai:consciousai_dev_password@localhost:5433/consciousai_staging
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/consciousai


# --- Database Connection Pool (PostgreSQL production/staging) ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Distributed Cache & Rate Limiting (Redis) ---
# Optional for single-instance / development; required for horizontally scaled production.
# REDIS_URL=redis://localhost:6379/0

# --- Authentication & JWT ---
# In production (APP_ENV=production or staging), JWT_SECRET_KEY MUST be set to a cryptographically
# secure string at least 32 characters long. The default key is blocked in production/staging.
JWT_SECRET_KEY=replace_with_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5

# --- Security & Hardening ---
SECURITY_HEADERS_ENABLED=true
MAX_REQUEST_BODY_BYTES=1048576
ENABLE_API_DOCS=true

# --- Logging ---
LOG_LEVEL=INFO

# --- AI Provider ---
# Options: mock, huggingface
# "mock" requires no GPU or downloads — safe for development.
AI_PROVIDER=mock

# --- AI Model Names (only used when AI_PROVIDER=huggingface) ---
LLM_MODEL_NAME=google/flan-t5-large
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMOTION_MODEL_NAME=facebook/bart-large-mnli
VALUE_MODEL_NAME=facebook/bart-large-mnli

# --- HuggingFace ---
# Required only when AI_PROVIDER=huggingface and models are gated.
HF_TOKEN=your_huggingface_token_here

# --- CORS ---
# Comma-separated list of allowed origins for the frontend (no wildcards in staging/prod).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Server ---
HOST=0.0.0.0
PORT=8000
WORKERS=1
GRACEFUL_TIMEOUT=30

